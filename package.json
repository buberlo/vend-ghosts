{
  "name": "vend-ghosts",
  "version": "0.1.0",
  "description": "A cozy arcade management game where you run a haunted office vending machine and dispense snacks to appease ghostly cravings.",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "game",
    "terminal",
    "typescript",
    "arcade",
    "management",
    "vending-machine",
    "haunted"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}